# ============================================================================
# MailTrust Configuration Environment File
# ============================================================================

# Flask Session Security & Secret Key (Generate with: openssl rand -hex 32)
MAILTRUST_SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-hex-string

# Fernet Secret for Encrypting TOTP MFA Secrets at Rest (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MAILTRUST_FERNET_SECRET=6e6f742d612d736563726574-change-in-production-32bytes-base64=

# Production Cookie Flags (Set to True in HTTPS Production Environments)
MAILTRUST_COOKIE_SECURE=False

# Session Lifetime Management (in minutes)
MAILTRUST_SESSION_IDLE_TIMEOUT_MINUTES=30
MAILTRUST_SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Database Connection (Defaults to local SQLite WAL database: sqlite:///mailtrust.db)
MAILTRUST_DATABASE_URI=sqlite:///mailtrust.db

# Privacy & Audit Data Retention (in days)
MAILTRUST_ANALYSIS_RETENTION_DAYS=30
MAILTRUST_AUDIT_LOG_RETENTION_DAYS=365

# Rate Limiting & Account Lockout
MAILTRUST_LOGIN_MAX_ATTEMPTS=5
MAILTRUST_LOGIN_WINDOW_SECONDS=300
MAILTRUST_LOCKOUT_DURATION_MINUTES=15
